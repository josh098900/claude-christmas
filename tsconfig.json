{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "strict": true,
    "noImplicitAny": false, "resolveJsonModule": true, "lib": ["ES2022", "DOM"], "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": false
  },
  "include": ["engine/src/**/*.ts"]
}
